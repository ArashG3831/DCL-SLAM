# Robot 1: custom e-puck + D500-style lidar.
# Starts left of center, facing left / away from robot2.
E-puck {
  name "robot1"
  window "<none>"
  translation -0.15 0.0 0.001
  rotation 0 0 1 3.1415
  controller "<extern>"
  version "2"
  camera_width 640
  camera_height 480
  turretSlot [
    Pi-puck {
    }
    Solid {
      translation 0 0 0.055
      name "d500 upper sensor housing"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.12
            roughness 0.5
          }
          geometry Cylinder {
            height 0.018
            radius 0.025
            subdivision 24
          }
        }
      ]
      boundingObject Cylinder {
        height 0.018
        radius 0.025
        subdivision 24
      }
    }
    Lidar {
      translation 0 0 0.055
      name "d500_lidar"
      fieldOfView 6.28318530718
      horizontalResolution 720
      numberOfLayers 1
      near 0.01
      minRange 0.03
      maxRange 12
      defaultFrequency 10
    }
    Gyro {
      name "d500_gyro"
      lookupTable [
        -10 -10 0
        10 10 0
      ]
    }
    Accelerometer {
      name "d500_accelerometer"
      lookupTable [
        -20 -20 0
        20 20 0
      ]
    }
  ]
}

# Robot 2: exact custom D500 e-puck clone.
# Starts right of center, 30 cm from robot1, facing right / away from robot1.
E-puck {
  name "robot2"
  window "<none>"
  translation 0.15 0.0 0.001
  rotation 0 0 1 0
  controller "<extern>"
  version "2"
  camera_width 640
  camera_height 480
  turretSlot [
    Pi-puck {
    }
    Solid {
      translation 0 0 0.055
      name "d500 upper sensor housing"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.12
            roughness 0.5
          }
          geometry Cylinder {
            height 0.018
            radius 0.025
            subdivision 24
          }
        }
      ]
      boundingObject Cylinder {
        height 0.018
        radius 0.025
        subdivision 24
      }
    }
    Lidar {
      translation 0 0 0.055
      name "d500_lidar"
      fieldOfView 6.28318530718
      horizontalResolution 720
      numberOfLayers 1
      near 0.01
      minRange 0.03
      maxRange 12
      defaultFrequency 10
    }
    Gyro {
      name "d500_gyro"
      lookupTable [
        -10 -10 0
        10 10 0
      ]
    }
    Accelerometer {
      name "d500_accelerometer"
      lookupTable [
        -20 -20 0
        20 20 0
      ]
    }
  ]
}

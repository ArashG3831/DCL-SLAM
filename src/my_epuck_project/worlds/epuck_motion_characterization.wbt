WorldInfo {
  info [
    "Diagnostic-only single e-puck motion characterization world."
  ]
  title "e-puck motion characterization"
  basicTimeStep 20
}
Viewpoint {
  orientation 0.57735 -0.57735 -0.57735 2.0944
  position 0 0 4
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 6 6
  wallHeight 0.3
}
DEF ROBOT1 E-puck {
  translation 0 0 0.001
  rotation 0 0 1 0
  name "robot1"
  controller "<extern>"
  window "<none>"
  version "2"
  turretSlot [
    Pi-puck {
    }
    Lidar {
      translation 0 0 0.055
      name "d500_lidar"
      horizontalResolution 720
      fieldOfView 6.28318530718
      numberOfLayers 1
      minRange 0.03
      maxRange 12
      defaultFrequency 10
    }
  ]
}
Robot {
  name "MotionGroundTruthSupervisor"
  controller "<extern>"
  supervisor TRUE
  window "<none>"
}
